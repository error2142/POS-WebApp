<h3 class="mt-4">🔐 系統登入</h3>

<form asp-action="Login" method="post" style="max-width:300px;">

    <input name="username" class="form-control mb-2" placeholder="帳號" />

    <input name="password" type="password" class="form-control mb-2" placeholder="密碼" />

    <button class="btn btn-primary w-100">登入</button>

</form>

@if (ViewBag.Error != null)
{
    <div class="text-danger mt-2">@ViewBag.Error</div>
}